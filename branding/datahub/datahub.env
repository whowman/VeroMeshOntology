# VeroMesh branding for DataHub. Passed to GMS and to the frontend through
# DataHub's own DATAHUB_LOCAL_GMS_ENV and DATAHUB_LOCAL_FRONTEND_ENV hooks
# (see scripts/dev-up.sh): GMS hands these to the UI, and the frontend serves
# /assets/icons/favicon.ico from REACT_APP_FAVICON_URL itself. The files live
# in the VeroMesh-branded frontend image (branding/datahub/build.sh).
REACT_APP_CUSTOM_THEME_ID=veromesh.theme.json
REACT_APP_LOGO_URL=assets/veromesh/veromesh-mark.svg
REACT_APP_FAVICON_URL=assets/veromesh/favicon.ico
REACT_APP_TITLE=VeroMesh
