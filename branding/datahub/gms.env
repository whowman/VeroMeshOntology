# VeroMesh branding for DataHub. Passed to GMS through DataHub's own
# DATAHUB_LOCAL_GMS_ENV hook (see scripts/dev-up.sh); the files live in the
# VeroMesh-branded frontend image (branding/datahub/build.sh).
REACT_APP_CUSTOM_THEME_ID=veromesh.theme.json
REACT_APP_LOGO_URL=assets/veromesh/veromesh-mark.svg
REACT_APP_FAVICON_URL=assets/veromesh/favicon.ico
REACT_APP_TITLE=VeroMesh
