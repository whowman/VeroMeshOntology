{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "${BOT_APP_ID}",
  "developer": {
    "name": "VeroMesh",
    "websiteUrl": "https://veromesh.ai",
    "privacyUrl": "https://veromesh.ai/privacy",
    "termsOfUseUrl": "https://veromesh.ai/terms"
  },
  "name": { "short": "VeroMesh", "full": "VeroMesh organizational model" },
  "description": {
    "short": "Confirm or object to the facts recorded for you in meetings.",
    "full": "When a VeroMesh steward records in a meeting the facts you confirmed there (your roles, your KPIs, the systems and data you own), VeroMesh sends them to you here. Confirm them, or object within five business days."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#0D0F14",
  "bots": [
    {
      "botId": "${BOT_APP_ID}",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["${HOST}"]
}
