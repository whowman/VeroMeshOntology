# Pinned upstream versions. Bump deliberately and re-run the license scan.
DATAHUB_VERSION=v1.8.0
# DataHub docker-compose profile: Postgres + OpenSearch, pgQueue instead of Kafka.
DATAHUB_PROFILE=quickstart-postgres
# Apache Jena Fuseki (RDF store), built from the official jar in deploy/fuseki/.
JENA_VERSION=6.2.0
# DataHub's official Helm charts (https://helm.datahubproject.io), matching DATAHUB_VERSION.
DATAHUB_CHART_VERSION=1.1.9
DATAHUB_PREREQUISITES_CHART_VERSION=0.3.1
# Helm, kubeconform and kind used by the test harness (tests/runner image, CI).
HELM_VERSION=v3.17.3
KUBECONFORM_VERSION=v0.6.7
KIND_VERSION=v0.27.0
